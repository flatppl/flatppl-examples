%%%
# Inferring the weights of two Normal components

The component means and scales are known. Each row of `components` supplies
the `mu` and `sigma` inputs of `Normal`; `ksuperpose` combines the resulting
distributions with inferred weights. The Dirichlet prior makes the weights
sum to one, so the mixture needs no explicit normalization.
%%%
flatppl_compat = "0.1"

components = table(mu = [-2.0, 2.0], sigma = [0.7, 0.9])
y_data = [-2.8, -2.2, -1.9, -1.4, 0.8, 1.1, 1.6, 1.9, 2.2, 2.6, 3.0, 3.2]

weights ~ Dirichlet([2.0, 2.0])
mixture = ksuperpose(Normal, weights, components)
y ~ iid(mixture, lengthof(y_data))

Pi_prior = lawof((weights = weights))
K_model = kernelof((y = y), weights)
L = likelihoodof(K_model, (y = y_data))
Pi_post = bayesupdate(L, Pi_prior)

Pi_post_domain = cartprod(weights = stdsimplex(2))
Pi_post_input = (weights = [0.5, 0.5])
