%%%
# Minimal model — `elementof`, `functionof`, and `kernelof`

A deliberately tiny model exercising the core reification operators. A reusable
square-root function is built by abstracting a deterministic expression over a
typed boundary variate: `a = elementof(nonnegreals)`, `b = a^0.5`, then
`f_sqrt = functionof(b)`. The observable `x` is three IID Normals whose scale
is `f_sqrt(sigma2)`; `kernelof(x, mu = mu)` reifies the forward model as a
Markov kernel in the boundary input `mu`, which is then applied to a concrete
input record.
%%%
flatppl_compat = "0.1"

a = elementof(nonnegreals)
b = a^0.5
f_sqrt = functionof(b)

mu = elementof(reals)
sigma2 ~ Exponential(1.0)
sigma = f_sqrt(sigma2)

x ~ iid(Normal(mu = mu, sigma = sigma), 3)
kernel = kernelof(x, mu = mu)
kernel_input = record(mu = 1.5)
dist = kernel(kernel_input)
