%%%
# Latent Gaussian process with Poisson counts

PosteriorDB's `gp_pois_regr-gp_pois_regr`. A squared-exponential Gaussian
process sets the log rate of each count. Standard Normal draws enter through
the Cholesky factor of the covariance, with a jitter of 1e-10 on the
diagonal. The normalized half-Normal amplitude prior adds log(2) to Stan's
target.
%%%
flatppl_compat = "0.1"

N = 11
data = load_data("data/gp_pois_regr.json", cartprod(
    x = cartpow(reals, N), k = cartpow(nonnegintegers, N)))
distance_sq = (addaxes(data.x, 0, 1) .- addaxes(data.x, 1, 0)).^2

rho ~ Gamma(shape = 25, rate = 4)
alpha ~ normalize(truncate(Normal(0, 2), interval(0, inf)))
f_tilde ~ iid(Normal(0, 1), N)
covariance = alpha^2 .* exp.(-0.5 .* distance_sq ./ rho^2) + 1e-10 * eye(N)
f = lower_cholesky(covariance) * f_tilde
y ~ Poisson.(exp.(f))

Pi_prior = lawof(record(rho = rho, alpha = alpha, f_tilde = f_tilde))
K_model = kernelof(record(y = y), rho = rho, alpha = alpha, f_tilde = f_tilde)
L = likelihoodof(K_model, record(y = data.k))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(rho = posreals, alpha = posreals, f_tilde = cartpow(reals, N))
Pi_post_input = record(rho = 5.7, alpha = 2.9, f_tilde = zeros(N))
